# Server port
PORT=5000

# MongoDB connection string
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/<dbname>?retryWrites=true&w=majority

# JWT options
JWT_SECRET=your_jwt_secret
JWT_EXPIRES_IN=1d

# Gmail credentials for OTP emails
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your-email-password

# Brevo API credentials for email sending
BREVO_API_KEY=your_brevo_api_key
BREVO_SENDER_EMAIL=your-sender-email@example.com

# Google Maps API key for Places API
GOOGLE_MAPS_API_KEY=your_server_only_google_places_api_key