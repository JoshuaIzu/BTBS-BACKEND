<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>BTBS Registration OTP</title>
    <style>
      body {
        font-family: Arial, sans-serif;
        background: #f0f4ff;
        color: #111;
        margin: 0;
        padding: 0;
      }
      .container {
        max-width: 600px;
        margin: 24px auto;
        background: #ffffff;
        border-radius: 12px;
        padding: 24px;
        box-shadow: 0 12px 30px rgba(0, 0, 0, 0.08);
      }
      .header {
        text-align: center;
      }
      .otp {
        font-size: 32px;
        font-weight: 700;
        color: #2f6fff;
        letter-spacing: 4px;
        margin: 24px 0;
      }
      .footer {
        margin-top: 24px;
        font-size: 14px;
        color: #666;
      }
      .button {
        display: inline-block;
        padding: 12px 24px;
        background: #2f6fff;
        color: white;
        text-decoration: none;
        border-radius: 8px;
      }
    </style>
  </head>
  <body>
    <div class="container">
      <div class="header">
        <h1>Welcome to BTBS, <%= name %>!</h1>
        <p>Confirm your email address by using the OTP below.</p>
      </div>

      <div class="otp"><%= otp %></div>

      <p>Your OTP will expire at <strong><%= expiresAt %></strong>.</p>
      <p>If you did not request this OTP, you can safely ignore this email.</p>

      <div class="footer">
        <p>Thank you for joining BTBS.</p>
      </div>
    </div>
  </body>
</html>
